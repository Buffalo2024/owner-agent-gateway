# Templates only. The demo creates temporary credentials automatically.
# Production: generate separate random credentials of at least 32 bytes.
AD_CONFIG=/absolute/path/outside/repository/config.json
AD_STATE=/absolute/path/outside/repository/state.json
AD_HOST=127.0.0.1
AD_PORT=8787
AD_SCHEDULER_URL=http://127.0.0.1:8787
AD_EXECUTOR_TOKEN=REPLACE_WITH_RANDOM_EXECUTOR_TOKEN
AD_AGENT_ID=my-agent
AD_ADAPTER=command
AD_COMMAND=/absolute/path/to/agent-wrapper
# JSON array of fixed arguments, never supplied by the task.
AD_COMMAND_ARGS=[]
